# PAM policy for nightsaver (installed by "make install", never overwritten).
#
# nightsaver authenticates through the "xscreensaver" PAM service when that policy
# exists, otherwise through this one; set pam_service = "nightsaver" in
# ~/.config/nightsaver/config.toml to force it. Same policy as xscreensaver:
# unix-selfauth-helper (a setuid helper from the unix-selfauth-helper package) lets an
# unprivileged process verify the invoking user's own password; if it does not
# succeed, the system policy is used.
auth		sufficient	pam_exec.so	return_prog_exit_status \
		expose_authtok /usr/local/libexec/unix-selfauth-helper
auth		include		system
account		include		system
session		include		system
password	include		system
